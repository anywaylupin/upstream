# Copy to .env and fill in. Never commit .env - it is gitignored.
#
#   cp .env.example .env
#
# Scripts read this file directly (tsx --env-file=.env); Next.js loads it too.

# ---------------------------------------------------------------------------
# Database - Neon Postgres
# ---------------------------------------------------------------------------
# 1. Create a project at https://console.neon.tech
# 2. Dashboard -> Connection Details -> copy the pooled connection string
# 3. Keep `sslmode=require`; the serverless driver needs it
#
# The pooled URL is the one the app uses. The unpooled variant is only needed
# if you ever swap to the WebSocket driver for interactive transactions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# GitHub API - server-side token for public data
# ---------------------------------------------------------------------------
# Used by the ingest scripts and the cron run, and as a fallback for public
# lookups (repo metadata, repo search) when no user token is available.
#
# 1. https://github.com/settings/personal-access-tokens
# 2. "Generate new token" -> fine-grained
# 3. No account permissions are needed - public repo data only
# 4. Public repos get 5,000 requests/hour on this token
GITHUB_TOKEN="github_pat_..."

# ---------------------------------------------------------------------------
# GitHub OAuth - how users sign in
# ---------------------------------------------------------------------------
# 1. https://github.com/settings/developers -> "New OAuth App"
# 2. Homepage URL:           http://localhost:3000
# 3. Authorization callback: http://localhost:3000/api/auth/callback/github
# 4. Add a second app (or a second callback) for the deployed URL
#
# Note: if you enable token expiration on the OAuth app, GitHub issues 8-hour
# access tokens. Upstream refreshes them automatically using the stored
# refresh token, so this is safe to leave on.
AUTH_GITHUB_ID="Ov23li..."
AUTH_GITHUB_SECRET="..."

# Signs the session cookie and wraps stored AI keys (AES-256-GCM).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Changing this logs everyone out AND makes stored AI keys undecryptable -
# users would have to re-enter them.
AUTH_SECRET="..."

# ---------------------------------------------------------------------------
# AI - shared fallback keys, one per provider
# ---------------------------------------------------------------------------
# These are the keys the app runs on for everyone. Users can also bring their
# own from the model picker in the header (BYOK), which is checked with a live
# call before it is saved.
#
# A provider with no key here and no key from the user is NOT offered in the
# model picker - a model that cannot run should not be listed. Set only the
# providers you actually want to expose; every one of them is optional except
# that you need at least one for summarizing to work at all.
#
# "Free tier" below means a recurring allowance that refills on its own, not a
# one-off trial credit.

# Google AI Studio - free tier, resets per minute and per day.
#   https://aistudio.google.com/apikey -> "Create API key"
# The default model (gemini-3.6-flash) lives here, so this is the one to set
# first. A burst of summaries will trip the per-minute limit; that is exactly
# why BYOK exists.
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."

# Groq - free tier, resets per minute and per day. Very fast.
#   https://console.groq.com/keys -> "Create API Key"
# Hosts Llama, GPT-OSS, Kimi and Qwen. The most generous free tier of the five.
GROQ_API_KEY="gsk_..."

# Mistral - free "Experiment" tier, rate limited.
#   https://console.mistral.ai/api-keys -> "Create new key"
# Requires a phone number on the account before the free tier activates.
MISTRAL_API_KEY=""

# Anthropic - no free tier, pay per token.
#   https://console.anthropic.com/settings/keys -> "Create Key"
# Needs credit on the account first. Claude tends to write the cleanest release
# summaries of the lot, at a price to match.
ANTHROPIC_API_KEY="sk-ant-..."

# DeepSeek - no free tier, but among the cheapest per token anywhere.
#   https://platform.deepseek.com/api_keys -> "Create API key"
# Top up a few dollars and it lasts a very long time at this workload.
DEEPSEEK_API_KEY="sk-..."

# xAI (Grok) - no free tier, pay per token.
#   https://console.x.ai -> API Keys -> "Create API Key"
XAI_API_KEY="xai-..."

# OpenAI - no free tier, pay per token.
#   https://platform.openai.com/api-keys -> "Create new secret key"
# Needs billing set up on the account or every call 429s.
OPENAI_API_KEY="sk-..."

# OpenRouter - one key, hundreds of models. Anything tagged :free resets daily;
# everything else is pay per token from prepaid credit.
#   https://openrouter.ai/keys -> "Create Key"
# Used through the OpenAI-compatible protocol, which is why no separate SDK
# package is installed for it.
OPENROUTER_API_KEY="sk-or-..."

# ---------------------------------------------------------------------------
# Cron - scheduled ingestion
# ---------------------------------------------------------------------------
# Vercel Cron calls GET /api/cron/ingest hourly (see vercel.json) and sends
# this as `Authorization: Bearer <secret>`. Without it the endpoint returns 500;
# with a wrong value, 401.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Set the same value in Vercel -> Project -> Settings -> Environment Variables,
# or the deployed cron will fail.
CRON_SECRET="..."

# ---------------------------------------------------------------------------
# Email - digest delivery (optional)
# ---------------------------------------------------------------------------
# Without this the app still ingests, summarizes and shows the digest; only
# sending is off. The "Send now" button in Settings -> Digest is disabled and
# says why, and the cron tick records the schedule without mailing anything.
#
# 1. https://resend.com -> API Keys -> "Create API Key" (sending access)
# 2. Verify a domain to send from your own address. Until you do, the shared
#    onboarding@resend.dev sender only delivers to the account's own address,
#    which is enough to test the whole path
RESEND_API_KEY=""

# Envelope sender. Must be on a domain verified in Resend.
DIGEST_FROM="Upstream <digest@yourdomain.com>"

# Absolute base for the links inside a digest email. Relative URLs are useless
# in an inbox. On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL, and
# locally to http://localhost:3000, so it is only needed for a custom domain.
NEXT_PUBLIC_APP_URL="https://upstream.yourdomain.com"
